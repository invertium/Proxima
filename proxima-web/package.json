{
  "name": "proxima-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Proxima — browser-native co-op bridge simulator (Three.js rewrite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "assets": "bun tools/optimize-assets.mjs",
    "relay": "bun server/relay.ts",
    "smoke": "bun test/smoke.mjs",
    "e2e": "bun test/e2e.mjs",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "verify": "bun run typecheck && bun test && bun run build && bun run e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@gltf-transform/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
