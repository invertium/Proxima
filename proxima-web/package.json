{
  "name": "proxima-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Proxima \u2014 browser-native co-op bridge simulator (Three.js rewrite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/optimize-assets.mjs",
    "relay": "node --experimental-strip-types server/relay.ts",
    "smoke": "node test/smoke.mjs",
    "e2e": "node test/e2e.mjs",
    "budget": "node test/budget.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
